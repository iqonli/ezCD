<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_soft">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/accent_soft" />
                    <stroke android:width="2dp" android:color="@color/accent_text" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke android:width="2dp" android:color="@color/accent_text" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

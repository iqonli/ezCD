<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="EzcdBaseTheme" parent="android:style/Theme.Material.Light">
        <item name="android:buttonStyle">@style/Widget.ezCD.FlatButton</item>
        <item name="android:colorAccent">#2196F3</item>
        <item name="android:windowBackground">#FFF9F9F9</item>
        <item name="android:statusBarColor">#1976D2</item>
        <item name="android:navigationBarColor">#1976D2</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlActivated">#2196F3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:actionBarStyle">@style/Widget.ezCD.ActionBar</item>
        <item name="android:alertDialogTheme">@style/Theme.ezCD.Dialog.Alert</item>
    </style>
    <style name="Widget.ezCD.FlatButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
    <style name="Widget.ezCD.ActionBar" parent="android:style/Widget.Material.Light.ActionBar">
        <item name="android:background">#FFFAFAFA</item>
        <item name="android:elevation">4dp</item>
        <item name="android:displayOptions">showTitle</item>
    </style>
    <style name="Theme.ezCD.Dialog.Alert" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#2196F3</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.ezCD.Dialog.Body</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.ezCD.Dialog.Body</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.ezCD.Dialog.Button</item>
    </style>
    <style name="TextAppearance.ezCD.Dialog.Body" parent="android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.ezCD.Dialog.Button" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_action_feedback</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.ezCD.Button.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.ezCD.Button.Secondary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.ezCD.Button.Destructive" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_destructive</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.ezCD.SmallAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Theme.ezCD" parent="@style/EzcdBaseTheme" />
</resources>
